# =====================================================================
# Dynatrace for AI — environment variables
# Repo: https://github.com/Dynatrace/dynatrace-for-ai
#
# Load before starting Claude Code / Cursor / Copilot:
#   set -a; source .env; set +a
# Copy to .env and fill in. .env is gitignored.
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED — Dynatrace MCP server (used by .mcp.json / mcp.json)
# ---------------------------------------------------------------------
# Your environment URL. https:// required, NO trailing slash.
DT_ENVIRONMENT=https://<your-env-id>.apps.dynatrace.com

# Platform token (starts with dt0s16.) with at least the MCP gateway scopes.
# Scopes: https://docs.dynatrace.com/docs/shortlink/dynatrace-mcp-server
DT_PLATFORM_TOKEN=<your-token>

# ---------------------------------------------------------------------
# OPTIONAL — only needed by specific setup / upgrade skills
# ---------------------------------------------------------------------
# Same URL as above; some skills (dt-upgrade, dt-setup-oneagent) read DT_ENV_URL.
DT_ENV_URL=${DT_ENVIRONMENT}

# Classic API access token (dt0c01.) — dt-setup-oneagent (InstallerDownload scope),
# dt-setup-genai (OTLP ingest: openTelemetryTrace.ingest, metrics.ingest, logs.ingest)
DT_API_TOKEN=<your-token>

# Classic token used by dt-upgrade (Classic -> Platform migration)
DT_CLASSIC_TOKEN=<your-token>

# Data ingest token — dt-setup-oneagent Kubernetes (Dynakube secret)
DT_DATA_INGEST_TOKEN=<your-token>

# OTLP endpoint for OTel collectors / GenAI instrumentation (classic live URL, no /api suffix)
# e.g. https://<your-env-id>.live.dynatrace.com
DT_ENDPOINT=https://<your-env-id>.live.dynatrace.com
